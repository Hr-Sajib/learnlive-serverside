# ---- Core ----
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/learnlive

# ---- Auth ----
# Both must be >= 32 chars. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_me_with_a_64_char_hex_string_0000000000000000000000000000
JWT_REFRESH_SECRET=replace_me_with_a_different_64_char_hex_string_00000000000000000
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Client / CORS ----
APP_URL=http://localhost:3000
API_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000

# ---- LiveKit (cloud.livekit.io -> Settings -> Keys) ----
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Server-to-server REST host, e.g. https://learnlive-xxxx.livekit.cloud
LIVEKIT_HOST=
# What the browser connects to, e.g. wss://learnlive-xxxx.livekit.cloud
LIVEKIT_WS_URL=

# ---- Attendance ----
# Percent of actual class duration a student must be present for to be marked present.
ATTENDANCE_THRESHOLD_PCT=60
# How often the reconciliation sweep re-reads LiveKit's live participant list.
PRESENCE_RECONCILE_INTERVAL_SEC=60

# ---- Bootstrap admin (used by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@learnlive.test
SEED_ADMIN_PHONE=01700000000
SEED_ADMIN_PASSWORD=Admin#12345
